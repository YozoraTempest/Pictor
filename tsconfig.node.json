{
  "extends": "./tsconfig.base.json",
  // The UI kit is JSX: it belongs to the browser project, not to this one.
  "exclude": ["packages/ui/src/**", "packages/harness/src/renderer/**"],
  "include": [
    "packages/*/src/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "apps/desktop/src/shared/**/*.ts",
    "plugins/*/src/**/*.ts",
    "vitest.config.ts",
    "apps/desktop/vite.config.ts"
  ]
}
