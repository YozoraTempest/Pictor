{
  "name": "pictor",
  "version": "0.2.1",
  "private": true,
  "description": "Agent-native desktop development environment",
  "author": {
    "name": "YozoraTempest",
    "email": "54313560+YozoraTempest@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YozoraTempest/Pictor.git"
  },
  "homepage": "https://github.com/YozoraTempest/Pictor#readme",
  "bugs": {
    "url": "https://github.com/YozoraTempest/Pictor/issues"
  },
  "desktopName": "pictor.desktop",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "deps:prepare": "install-electron --no",
    "deps:verify": "node scripts/verify-electron.mjs",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:lint": "eslint . --max-warnings=0",
    "typecheck": "npm run check:types",
    "lint": "npm run check:lint",
    "format": "prettier --write .",
    "format:check": "npm run check:format",
    "test": "vitest run",
    "test:unit": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:module": "node scripts/test-module.mjs",
    "module:new": "node scripts/create-module.mjs",
    "test:e2e:run": "playwright test",
    "test:e2e:smoke:run": "playwright test --grep @smoke",
    "test:e2e": "npm run build:app && npm run test:e2e:run",
    "test:e2e:smoke": "npm run build:app && npm run test:e2e:smoke:run",
    "build:app": "electron-vite build",
    "build": "npm run build:app",
    "verify:fast": "npm run check:format && npm run check:types && npm run check:lint && npm test",
    "verify:pr": "npm run verify:fast && npm run build:app && npm run test:e2e:smoke:run",
    "verify:release": "npm run verify:fast && npm run build:app && npm run test:e2e:run && npm run package:build && npm run package:verify",
    "package:dir:build": "electron-builder --dir --x64",
    "package:build": "electron-builder --x64 --publish never",
    "package:windows:build": "electron-builder --win nsis --x64 --publish never",
    "package:linux:build": "electron-builder --linux pacman AppImage --x64 --publish never",
    "package:dir": "npm run build:app && npm run package:dir:build",
    "package:verify": "node scripts/verify-package.mjs",
    "package:verify:windows": "node scripts/verify-windows-package.mjs",
    "package:verify:linux": "node scripts/verify-linux-packages.mjs",
    "package:verify:linux:launch": "node scripts/verify-linux-launch.mjs",
    "package": "npm run build:app && npm run package:build && npm run package:verify"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.47",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.pictor.desktop",
    "productName": "Pictor",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "toolsets": {
      "appimage": "1.0.3"
    },
    "win": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "pictor",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "pacman": {
      "artifactName": "${productName}-${version}-arch-x64.${ext}",
      "compression": "zstd",
      "depends": [
        "alsa-lib",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "glib2",
        "glibc",
        "gtk3",
        "libcups",
        "libgcc",
        "libsecret",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "mesa",
        "nspr",
        "nss",
        "pango",
        "systemd-libs",
        "xdg-utils"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
