{
  "name": "@vulonlok/pictor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-native local development environment",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "deps:prepare": "install-electron",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm build:host:debug && pnpm --filter @vulonlok/harness dev",
    "build": "pnpm build:js && pnpm build:host",
    "build:js": "pnpm --filter @vulonlok/harness build",
    "build:host": "cargo build --release -p pictor-host-core",
    "build:host:debug": "cargo build -p pictor-host-core",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:js && pnpm test:rust",
    "test:js": "vitest run",
    "test:rust": "cargo test -p pictor-host-core",
    "verify": "pnpm format:check && node scripts/check-style-tokens.mjs && pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "node e2e/run.mjs",
    "pack:dir": "pnpm build && electron-builder --dir --projectDir apps/desktop --config electron-builder.json",
    "pack:dist": "pnpm build && electron-builder --projectDir apps/desktop --config electron-builder.json",
    "kernel:probe": "node scripts/kernel-probe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
