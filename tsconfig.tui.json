{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": false,
    "outDir": "out/tui",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/tui/**/*.ts",
    "src/application/**/*.ts",
    "src/commands/**/*.ts",
    "src/kernel/**/*.ts",
    "src/node/persistence/**/*.ts",
    "src/application/coordinator.ts",
    "src/plugin/loader.ts",
    "src/node/plugins/plugin-manager.ts",
    "src/node/plugins/plugin-store.ts",
    "src/plugin/**/*.ts",
    "src/runtime/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/runtime/host.ts",
    "plugins/tui-delegate/**/*.test.ts"
  ]
}
