{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pictor/shared": ["./packages/shared/src/index.ts"],
      "@pictor/racp": ["./packages/racp/src/index.ts"],
      "@pictor/host-client": ["./packages/host-client/src/index.ts"],
      "@pictor/application": ["./packages/application/src/index.ts"],
      "@pictor/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@pictor/plugin-host": ["./packages/plugin-host/src/index.ts"],
      "@pictor/agent-runtime": ["./packages/agent-runtime/src/index.ts"],
      "@pictor/model-config": ["./packages/model-config/src/index.ts"],
      "@pictor/chat": ["./packages/chat/src/index.ts"]
    }
  }
}
